DATABASE_URL=postgresql+psycopg://material:material@localhost:5432/material_master
EMBEDDING_MODEL=
MATCHING_WEIGHTS={"semantic":0.25,"attributes":0.30,"specification":0.25,"category":0.10,"unit":0.05,"procurement":0.05}
CONFIDENCE_THRESHOLDS={"strong":0.95,"review":0.80,"investigate":0.60}
LOG_LEVEL=INFO

# --- Authentication (off by default; see backend/API.md "Authentication") ---
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-value-before-enabling-auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Upload limits ---
MAX_UPLOAD_BYTES=10485760
